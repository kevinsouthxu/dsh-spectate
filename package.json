{
  "name": "dsh-spectate",
  "version": "0.1.1",
  "description": "陪玩台 — 让 AI 陪你看游戏的可视化观察台（DSH / 大肥鱼配套）",
  "main": "main.js",
  "private": false,
  "license": "MIT",
  "author": "",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack:win": "electron-packager . dsh-spectate --platform=win32 --arch=x64 --out=release --asar --overwrite --ignore=\"^/(release|dist|receiver-state|shots|node_modules)($|/)\" --ignore=\"^/\\.env\" --ignore=\"^/config\\.json$\""
  },
  "keywords": [
    "dsh",
    "electron",
    "game",
    "companion",
    "vision"
  ],
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.2.3"
  }
}
